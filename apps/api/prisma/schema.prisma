generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelKind {
  TEXT
  VOICE
}

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  passwordHash     String
  displayName      String
  avatarUrl        String?
  activeSessionId  String?
  memberships      Membership[]
  messages         Message[]
  messageReactions MessageReaction[]
  channelAccess    ChannelMemberAccess[]
  createdInvites   SpaceInvite[]         @relation("InviteCreator")
  createdAt        DateTime              @default(now())
}

model Space {
  id          String        @id @default(cuid())
  name        String
  memberships Membership[]
  channels    Channel[]
  invites     SpaceInvite[]
  roles       SpaceRole[]
  createdAt   DateTime      @default(now())
}

model Membership {
  userId        String
  spaceId       String
  role          String           @default("member")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  space         Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  assignedRoles MembershipRole[]

  @@id([userId, spaceId])
}

model SpaceRole {
  id          String           @id @default(cuid())
  spaceId     String
  name        String
  color       String           @default("#87909f")
  position    Int              @default(0)
  permissions String[]         @default([])
  space       Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  members     MembershipRole[]
  createdAt   DateTime         @default(now())

  @@unique([spaceId, name])
  @@index([spaceId, position])
}

model MembershipRole {
  userId     String
  spaceId    String
  roleId     String
  membership Membership @relation(fields: [userId, spaceId], references: [userId, spaceId], onDelete: Cascade)
  role       SpaceRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId, roleId])
  @@index([roleId])
}

model Channel {
  id           String                @id @default(cuid())
  spaceId      String
  name         String
  kind         ChannelKind
  position     Int                   @default(0)
  isRestricted Boolean               @default(false)
  space        Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  messages     Message[]
  memberAccess ChannelMemberAccess[]
  roleAccess   ChannelRoleAccess[]
  createdAt    DateTime              @default(now())

  @@unique([spaceId, name])
  @@index([spaceId, position])
}

model ChannelMemberAccess {
  channelId String
  userId    String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model ChannelRoleAccess {
  channelId String
  role      String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, role])
}

model SpaceInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  spaceId     String
  createdById String
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([spaceId, createdAt])
}

model Message {
  id        String            @id @default(cuid())
  channelId String
  authorId  String
  replyToId String?
  body      String            @db.VarChar(4000)
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplies")
  reactions MessageReaction[]
  createdAt DateTime          @default(now())
  editedAt  DateTime?

  @@index([channelId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  @@index([messageId, emoji])
}
